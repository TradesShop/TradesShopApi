  <PackageReference Include="AWSSDK.Core" Version="4.0.100" />

  <PackageReference Include="AWSSDK.Extensions.NETCore.Setup" Version="4.0.4.4" />
   
  <PackageReference Include="AWSSDK.S3" Version="4.0.100" />
   
